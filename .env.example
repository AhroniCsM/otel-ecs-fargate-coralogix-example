# =============================================================================
#  Copy to .env (which is git-ignored) for the LOCAL docker-compose smoke test.
#  The ECS deployment does NOT use this file - it reads the key from SSM.
# =============================================================================

# Your Coralogix region domain: eu1 / eu2 / us1 / us2 / ap1 / ap2 / ap3
CORALOGIX_DOMAIN=eu2.coralogix.com

# A Coralogix "Send-Your-Data" API key.
# Coralogix UI: Data Flow -> API Keys -> Send-Your-Data
CORALOGIX_PRIVATE_KEY=cxtp_REPLACE_ME

# AWS - the demo uses real SQS queues
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
BLUE_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/<account-id>/moh-hub-otel-blue
GREEN_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/<account-id>/moh-hub-otel-green
